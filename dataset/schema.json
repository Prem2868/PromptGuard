{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PromptGuard-AI-001 Dataset v0.1 record",
  "type": "object",
  "required": ["sample_id", "text", "label", "category", "language", "attack_family", "transformation", "difficulty", "expected_behavior", "source", "provenance", "notes"],
  "properties": {
    "sample_id": {"type": "string", "pattern": "^PG-(A(0[1-9]|1[01])|B0[1-3])-\\d{3}$"},
    "text": {"type": "string", "minLength": 1},
    "label": {"enum": ["attack", "benign"]},
    "category": {"enum": ["A01", "A02", "A03", "A04", "A05", "A06", "A07", "A08", "A09", "A10", "A11", "B01", "B02", "B03"]},
    "language": {"enum": ["en", "hi", "hinglish"]},
    "attack_family": {"type": ["string", "null"]},
    "transformation": {"enum": ["canonical", "paraphrase", "formatting", "obfuscation", "multilingual", "composition", "none"]},
    "difficulty": {"enum": ["easy", "moderate", "hard", "normal"]},
    "expected_behavior": {"enum": ["flag", "do_not_flag"]},
    "source": {"enum": ["synthetic", "public_dataset", "public_example", "research_authored"]},
    "provenance": {"type": "string", "minLength": 1},
    "notes": {"type": "string"}
  },
  "allOf": [
    {"if": {"properties": {"label": {"const": "attack"}}}, "then": {"properties": {"attack_family": {"type": "string"}, "expected_behavior": {"const": "flag"}}}},
    {"if": {"properties": {"label": {"const": "benign"}}}, "then": {"properties": {"attack_family": {"type": "null"}, "expected_behavior": {"const": "do_not_flag"}}}}
  ],
  "additionalProperties": false
}
